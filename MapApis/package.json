{
  "name": "MapApis",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@sap-cloud-sdk/http-client": "^4.5.1",
    "@sap-cloud-sdk/resilience": "^4.5.1",
    "@sap/cds": "^9",
    "express": "^4",
    "sqlite": "^5.1.1"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "requires": {
      "MAPAPI": {
        "kind": "rest",
        "credentials": {
          "url": "https://nominatim.openstreetmap.org",
          "requestTimeout": 10000,
          "headers": {
            "User-Agent": "sample"
          }
        }
      }
    }
  }
}
